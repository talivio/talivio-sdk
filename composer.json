{
    "name": "talivio/sdk",
    "description": "Talivio Accounts SSO + central ops (error/support telemetry) + Talivio AI gateway client for every Talivio product.",
    "type": "library",
    "keywords": [
        "talivio",
        "laravel",
        "sso",
        "oauth",
        "telemetry",
        "ai-gateway",
        "gdpr"
    ],
    "homepage": "https://github.com/talivio/talivio-sdk",
    "license": "proprietary",
    "support": {
        "issues": "https://github.com/talivio/talivio-sdk/issues",
        "source": "https://github.com/talivio/talivio-sdk",
        "security": "https://github.com/talivio/talivio-sdk/security/policy",
        "email": "info@talivio.com"
    },
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "laravel/socialite": "^5.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0",
        "laravel/pint": "^1.27"
    },
    "autoload": {
        "psr-4": {
            "Talivio\\Sdk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Talivio\\Sdk\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "lint": "pint --test",
        "fix": "pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Talivio\\Sdk\\TalivioServiceProvider"
            ],
            "aliases": {
                "TalivioOps": "Talivio\\Sdk\\Facades\\TalivioOps"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
